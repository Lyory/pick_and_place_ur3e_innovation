<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">
  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="prefix" default=""/>
  <xacro:include filename="$(find ur_moveit_config)/srdf/ur_macro.srdf.xacro"/>
  <xacro:ur_srdf name="$(arg name)" prefix="$(arg prefix)"/>
  <!-- The Robotiq closed-chain geometry overlaps at its hinges. The arm
       planner treats the assembled gripper as one tool; Gazebo simulates its
       internal joints and finger contact independently. -->
  <disable_collisions link1="$(arg prefix)ur_to_robotiq_link" link2="$(arg prefix)robotiq_mount" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)ur_to_robotiq_link" link2="$(arg prefix)robotiq_85_base_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)ur_to_robotiq_link" link2="$(arg prefix)robotiq_85_left_knuckle_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)ur_to_robotiq_link" link2="$(arg prefix)robotiq_85_right_knuckle_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)ur_to_robotiq_link" link2="$(arg prefix)robotiq_85_left_finger_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)ur_to_robotiq_link" link2="$(arg prefix)robotiq_85_right_finger_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)ur_to_robotiq_link" link2="$(arg prefix)robotiq_85_left_inner_knuckle_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)ur_to_robotiq_link" link2="$(arg prefix)robotiq_85_right_inner_knuckle_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)ur_to_robotiq_link" link2="$(arg prefix)robotiq_85_left_finger_tip_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)ur_to_robotiq_link" link2="$(arg prefix)robotiq_85_right_finger_tip_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_mount" link2="$(arg prefix)robotiq_85_base_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_mount" link2="$(arg prefix)robotiq_85_left_knuckle_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_mount" link2="$(arg prefix)robotiq_85_right_knuckle_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_mount" link2="$(arg prefix)robotiq_85_left_finger_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_mount" link2="$(arg prefix)robotiq_85_right_finger_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_mount" link2="$(arg prefix)robotiq_85_left_inner_knuckle_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_mount" link2="$(arg prefix)robotiq_85_right_inner_knuckle_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_mount" link2="$(arg prefix)robotiq_85_left_finger_tip_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_mount" link2="$(arg prefix)robotiq_85_right_finger_tip_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_base_link" link2="$(arg prefix)robotiq_85_left_knuckle_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_base_link" link2="$(arg prefix)robotiq_85_right_knuckle_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_base_link" link2="$(arg prefix)robotiq_85_left_finger_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_base_link" link2="$(arg prefix)robotiq_85_right_finger_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_base_link" link2="$(arg prefix)robotiq_85_left_inner_knuckle_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_base_link" link2="$(arg prefix)robotiq_85_right_inner_knuckle_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_base_link" link2="$(arg prefix)robotiq_85_left_finger_tip_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_base_link" link2="$(arg prefix)robotiq_85_right_finger_tip_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_left_knuckle_link" link2="$(arg prefix)robotiq_85_right_knuckle_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_left_knuckle_link" link2="$(arg prefix)robotiq_85_left_finger_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_left_knuckle_link" link2="$(arg prefix)robotiq_85_right_finger_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_left_knuckle_link" link2="$(arg prefix)robotiq_85_left_inner_knuckle_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_left_knuckle_link" link2="$(arg prefix)robotiq_85_right_inner_knuckle_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_left_knuckle_link" link2="$(arg prefix)robotiq_85_left_finger_tip_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_left_knuckle_link" link2="$(arg prefix)robotiq_85_right_finger_tip_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_right_knuckle_link" link2="$(arg prefix)robotiq_85_left_finger_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_right_knuckle_link" link2="$(arg prefix)robotiq_85_right_finger_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_right_knuckle_link" link2="$(arg prefix)robotiq_85_left_inner_knuckle_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_right_knuckle_link" link2="$(arg prefix)robotiq_85_right_inner_knuckle_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_right_knuckle_link" link2="$(arg prefix)robotiq_85_left_finger_tip_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_right_knuckle_link" link2="$(arg prefix)robotiq_85_right_finger_tip_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_left_finger_link" link2="$(arg prefix)robotiq_85_right_finger_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_left_finger_link" link2="$(arg prefix)robotiq_85_left_inner_knuckle_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_left_finger_link" link2="$(arg prefix)robotiq_85_right_inner_knuckle_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_left_finger_link" link2="$(arg prefix)robotiq_85_left_finger_tip_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_left_finger_link" link2="$(arg prefix)robotiq_85_right_finger_tip_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_right_finger_link" link2="$(arg prefix)robotiq_85_left_inner_knuckle_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_right_finger_link" link2="$(arg prefix)robotiq_85_right_inner_knuckle_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_right_finger_link" link2="$(arg prefix)robotiq_85_left_finger_tip_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_right_finger_link" link2="$(arg prefix)robotiq_85_right_finger_tip_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_left_inner_knuckle_link" link2="$(arg prefix)robotiq_85_right_inner_knuckle_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_left_inner_knuckle_link" link2="$(arg prefix)robotiq_85_left_finger_tip_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_left_inner_knuckle_link" link2="$(arg prefix)robotiq_85_right_finger_tip_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_right_inner_knuckle_link" link2="$(arg prefix)robotiq_85_left_finger_tip_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_right_inner_knuckle_link" link2="$(arg prefix)robotiq_85_right_finger_tip_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)robotiq_85_left_finger_tip_link" link2="$(arg prefix)robotiq_85_right_finger_tip_link" reason="Robotiq mechanism"/>
  <disable_collisions link1="$(arg prefix)wrist_3_link" link2="$(arg prefix)ur_to_robotiq_link" reason="Mounted tool"/>
  <disable_collisions link1="$(arg prefix)wrist_3_link" link2="$(arg prefix)robotiq_mount" reason="Mounted tool"/>
  <disable_collisions link1="$(arg prefix)wrist_3_link" link2="$(arg prefix)robotiq_85_base_link" reason="Mounted tool"/>
</robot>
